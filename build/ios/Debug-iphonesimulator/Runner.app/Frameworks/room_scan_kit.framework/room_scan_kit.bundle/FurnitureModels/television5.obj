# UyDosh television5 — flat black panel (Apple RoomPlan-style)
# Thin upright slab ~1.20 × 0.675 × 0.05 m (16:9). Front on min-Z (Kenney
# convention; placement applies yaw π so it faces RoomPlan +Z).
mtllib television5.mtl
g televisionFlat

v -0.600000 0.000000 -0.025000
v  0.600000 0.000000 -0.025000
v  0.600000 0.000000  0.025000
v -0.600000 0.000000  0.025000
v -0.600000 0.675000 -0.025000
v  0.600000 0.675000 -0.025000
v  0.600000 0.675000  0.025000
v -0.600000 0.675000  0.025000

vn  0 -1  0
vn  0  1  0
vn  0  0 -1
vn  0  0  1
vn -1  0  0
vn  1  0  0

usemtl metalDark
# Bottom
f 1//1 2//1 3//1
f 1//1 3//1 4//1
# Top
f 5//2 8//2 7//2
f 5//2 7//2 6//2
# Front (min-Z)
f 1//3 5//3 6//3
f 1//3 6//3 2//3
# Back (+Z)
f 4//4 3//4 7//4
f 4//4 7//4 8//4
# Left / right
f 1//5 4//5 8//5
f 1//5 8//5 5//5
f 2//6 6//6 7//6
f 2//6 7//6 3//6
